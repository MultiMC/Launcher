#ifndef WIN32_LEAN_AND_MEAN
#define WIN32_LEAN_AND_MEAN
#endif
#include <windows.h>

// configured by CMake into the build directory, so the files next to it are named in full
IDI_ICON1               ICON    DISCARDABLE     "@Launcher_Branding_SourceDir@/MultiMC.ico"
1 RT_MANIFEST "@Launcher_Branding_SourceDir@/MultiMC.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @Launcher_VERSION_MAJOR@,@Launcher_VERSION_MINOR@,@Launcher_VERSION_BUILD_PART@,0
PRODUCTVERSION  @Launcher_VERSION_MAJOR@,@Launcher_VERSION_MINOR@,@Launcher_VERSION_BUILD_PART@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
        BLOCK "StringFileInfo"
        BEGIN
                BLOCK "000004b0"
                BEGIN
                        VALUE "CompanyName", "MultiMC Contributors"
                        VALUE "FileDescription", "MultiMC Launcher"
                        VALUE "FileVersion", "@Launcher_VERSION_NAME@"
                        VALUE "ProductName", "MultiMC"
                        VALUE "ProductVersion", "@Launcher_VERSION_NAME@"
                END
        END
        BLOCK "VarFileInfo"
        BEGIN
                VALUE "Translation", 0x0000, 0x04b0 // Unicode
        END
END
